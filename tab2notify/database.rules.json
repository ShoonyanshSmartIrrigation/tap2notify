{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      },
      ".indexOn": ["phone", "phoneNumber", "role"]
    },
    "tables": {
      "$managerPhone": {
        ".read": "auth != null && (auth.token.role == 'waiter' ? auth.token.managerPhone == $managerPhone : true)",
        ".write": "auth != null && (auth.token.role == 'waiter' ? auth.token.managerPhone == $managerPhone : true)",
        ".indexOn": ["table_number", "flag", "status", "assigned_waiter_id"]
      }
    },
    "waiters": {
      "$managerPhone": {
        ".read": "auth != null && (auth.token.role == 'waiter' ? auth.token.managerPhone == $managerPhone : true)",
        ".write": "auth != null && (auth.token.role == 'waiter' ? auth.token.managerPhone == $managerPhone : true)",
        ".indexOn": ["waiterId", "status", "name"]
      }
    },
    "serviceRequests": {
      "$managerPhone": {
        ".read": "auth != null && (auth.token.role == 'waiter' ? auth.token.managerPhone == $managerPhone : true)",
        ".write": "auth != null && (auth.token.role == 'waiter' ? auth.token.managerPhone == $managerPhone : true)",
        ".indexOn": ["createdAt", "status", "priority", "tableNumber"]
      }
    },
    "devices": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "device_tokens": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["userId", "role", "active", "managerPhone"]
    },
    "notifications_queue": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
